{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "khalid-growth-automation",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ADMIN_EMAIL": "saim.goodm@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khalid-portfolio-db",
      "database_id": "7d987f40-2252-4b57-ac3a-0a77883850a5",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "khalid-portfolio-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
